# Copy to backend/.env (local run) or to .env next to docker-compose.yml (Docker). Never commit the real file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

# Backend behaviour (defaults shown)
MAX_UPLOAD_MB=5
CORS_ORIGINS=http://localhost:5173
AUTO_TRAIN_FORECAST=true
SYNTHETIC_DAYS=730
DEFAULT_LATITUDE=30.9
REFERENCE_CAPACITY_KW=100
LOW_CONFIDENCE_THRESHOLD=0.6
# MODEL_DIR=backend/models
